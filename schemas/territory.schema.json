{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jaragua.dev/schemas/territory.schema.json",
  "title": "Territory",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "state": {
      "type": "string",
      "minLength": 2
    },
    "officialCode": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "vintage": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "licenseId": {
            "type": [
              "string",
              "null"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "geometryType": {
            "enum": [
              "Point",
              "MultiPoint",
              "Polygon",
              "MultiPolygon",
              "LineString",
              "MultiLineString"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "vintage",
          "sourceId",
          "uri",
          "geometryType"
        ]
      }
    }
  },
  "required": [
    "id",
    "label",
    "country",
    "state",
    "officialCode",
    "units"
  ]
}
