{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jaragua.dev/schemas/module.schema.json",
  "title": "Module",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "labelKey": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "coming-soon",
        "disabled"
      ]
    },
    "domainPackage": {
      "type": [
        "string",
        "null"
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "labelKey",
    "status",
    "children"
  ]
}
