{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jaragua.dev/schemas/attribution.schema.json",
  "title": "Attribution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "licenseUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "required": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "label",
    "url",
    "required"
  ]
}
