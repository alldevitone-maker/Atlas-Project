{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.jaragua.dev/schemas/metric.schema.json",
  "title": "Metric",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "labelKey": {
      "type": "string",
      "minLength": 1
    },
    "expression": {
      "$ref": "#/$defs/expression"
    },
    "format": {
      "enum": [
        "percent",
        "integer",
        "decimal",
        "percentage-points"
      ]
    },
    "comparisonPolicyId": {
      "type": [
        "string",
        "null"
      ]
    },
    "minReliableObservations": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "sequential",
            "diverging",
            "categorical"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "center": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "ref"
      ]
    },
    "classification": {
      "enum": [
        "continuous",
        "quantile",
        "jenks",
        "manual"
      ]
    }
  },
  "required": [
    "id",
    "labelKey",
    "expression",
    "format",
    "palette",
    "classification"
  ],
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "field"
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "op",
            "field"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "literal"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "ratio"
            },
            "numerator": {
              "$ref": "#/$defs/expression"
            },
            "denominator": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "numerator",
            "denominator"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "difference"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "sum"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "op",
            "items"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "coalesce"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "op",
            "items"
          ]
        }
      ]
    }
  }
}
